<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<meta name="color-scheme" content="dark">
<title>مهند AI</title>
<style>
:root{box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px);--bg:#050a18;--pan:#0a1226;--card:#0d1630;--bub:#111b36;--bl:#1769ff;--ne:#2d8cff;--bd:#17264a;--tx:#eaf1ff;--mut:#8fa0c0;--fs:16px}
html{scroll-padding-top:env(safe-area-inset-top,0px)}
*{box-sizing:border-box}
html,body{height:100%;margin:0;background:var(--bg)}
body{color:var(--tx);font-family:-apple-system,"Segoe UI","Noto Sans Arabic",Tahoma,Arial,sans-serif;display:flex;direction:ltr;-webkit-font-smoothing:antialiased}
button{font-family:inherit;color:inherit;cursor:pointer}
svg.i{width:22px;height:22px;fill:none;stroke:currentColor;stroke-width:1.8;stroke-linecap:round;stroke-linejoin:round;flex:none}
#sb{width:300px;flex:none;background:linear-gradient(180deg,var(--pan),#070d1f);border-right:1px solid var(--bd);display:flex;flex-direction:column;padding:22px 14px 16px;z-index:30;direction:rtl}
.lg{text-align:center}
.pf{display:block;object-fit:cover;aspect-ratio:1/1;border-radius:50%}
.lg .ring{width:112px;height:112px;margin:0 auto;filter:drop-shadow(0 0 14px rgba(45,140,255,.7))}
.lg h2{margin:10px 0 4px;font-size:34px;color:var(--ne);text-shadow:0 0 18px rgba(45,140,255,.6);font-weight:800}
.lg p{margin:0 6px 18px;font-size:13px;color:var(--mut);line-height:1.7}
.nv{direction:ltr;display:flex;align-items:center;gap:16px;width:100%;border:1px solid transparent;background:none;border-radius:14px;padding:14px 18px;font-size:16.5px;text-align:left;margin-bottom:4px}
.nv span{direction:rtl}
.nv:hover{background:rgba(45,140,255,.08)}
.nv.on{background:rgba(23,105,255,.32);border-color:rgba(45,140,255,.35)}
.nv.on svg{color:var(--ne)}
.sp1{flex:1}
.sh{text-align:center}
.sh svg.sd{width:150px;height:130px;opacity:.95}
.sh h3{margin:6px 0 2px;font-size:18px}
.sh small{display:block;color:var(--mut);font-size:12px;direction:ltr}
.sh em{display:block;font-style:normal;color:var(--ne);font-size:12.5px;margin-top:10px}
#main{flex:1;min-width:0;height:100%;display:flex;flex-direction:column;position:relative}
.top{margin:12px 14px 0;padding:10px 14px;background:var(--card);border:1px solid var(--bd);border-radius:20px;display:flex;align-items:center;gap:12px;direction:ltr}
.ib{width:40px;height:40px;border-radius:50%;border:0;background:none;display:grid;place-items:center;flex:none}
.ib:hover{background:rgba(45,140,255,.14)}
.ib.on{background:rgba(23,105,255,.4);color:#fff}
.av{position:relative;width:46px;height:46px;flex:none}
.av img{width:46px;height:46px;box-shadow:0 0 12px rgba(45,140,255,.55)}
.av:after{content:"";position:absolute;right:0;bottom:2px;width:11px;height:11px;border-radius:50%;background:#26d07c;border:2px solid var(--card)}
.nm{flex:1;min-width:0;direction:rtl;text-align:right;padding-right:6px}
.nm b{display:block;font-size:19px}
.nm small{color:var(--mut);font-size:13px}
.pop{position:absolute;z-index:40;background:#0d1834;border:1px solid var(--bd);border-radius:16px;padding:6px;min-width:190px;box-shadow:0 14px 40px rgba(0,0,0,.6);direction:rtl;display:none}
.pop.show{display:block}
.pop button{display:flex;align-items:center;justify-content:space-between;width:100%;border:0;background:none;text-align:start;padding:11px 14px;border-radius:10px;font-size:14.5px}
.pop button:hover{background:rgba(45,140,255,.14)}
.pop button.on{color:var(--ne)}
.view{display:none;flex:1;min-height:0;flex-direction:column}
.view.show{display:flex}
#chat{flex:1;overflow-y:auto;padding:18px 14px;display:flex;flex-direction:column;gap:20px;direction:ltr}
.r{display:flex;align-items:flex-end;gap:12px;animation:in .3s ease}
.r.ai{justify-content:flex-start}
.r.me{justify-content:flex-end}
.r .ua{width:40px;height:40px;border-radius:50%;border:2px solid var(--ne);display:grid;place-items:center;color:var(--ne);background:#0b1a3d;flex:none}
.r .ua svg{width:22px;height:22px}
.r .sa{width:42px;height:42px;flex:none}
.r .sa img{width:42px;height:42px;box-shadow:0 0 8px rgba(45,140,255,.5)}
.b{direction:rtl;max-width:min(78%,520px);padding:14px 18px 8px;font-size:var(--fs);line-height:1.8}
.ai .b{background:var(--bub);border:1px solid var(--bd);border-radius:22px 22px 22px 6px}
.me .b{background:linear-gradient(135deg,#1769ff,#0f55e0);border-radius:22px 22px 6px 22px;box-shadow:0 6px 24px rgba(23,105,255,.3)}
.tx{white-space:pre-wrap;word-wrap:break-word}
.mt{display:flex;align-items:center;gap:8px;margin-top:4px;font-size:12px;color:var(--mut);direction:ltr}
.me .mt{color:#c6dcff}
.mt button{border:0;background:none;color:var(--mut);padding:2px 4px;font-size:14px}
.ck{color:#8fc0ff;letter-spacing:-3px}
.dots{display:inline-flex;gap:5px;padding:8px 0}
.dots i{width:8px;height:8px;border-radius:50%;background:var(--ne);animation:dt 1.2s infinite}
.dots i:nth-child(2){animation-delay:.2s}.dots i:nth-child(3){animation-delay:.4s}
.cur:after{content:"";display:inline-block;width:8px;height:8px;border-radius:50%;background:var(--ne);margin-inline-start:6px;animation:bk 1s infinite}
@keyframes dt{0%,60%,100%{opacity:.25;transform:translateY(0)}30%{opacity:1;transform:translateY(-4px)}}
@keyframes bk{50%{opacity:.2}}
@keyframes in{from{opacity:0;transform:translateY(8px)}to{opacity:1;transform:none}}
.chips{display:flex;flex-wrap:wrap;gap:8px;padding:2px 54px;direction:rtl;justify-content:flex-start}
.chips button{border:1px solid var(--bd);background:var(--card);border-radius:16px;padding:9px 15px;font-size:13.5px}
.chips button:hover{border-color:var(--ne)}
.cmp{margin:0 14px 8px;padding:12px;background:var(--card);border:1px solid var(--bd);border-radius:24px;display:flex;align-items:center;gap:10px;direction:ltr}
.plus{width:52px;height:52px;border-radius:50%;border:1px solid var(--bd);background:#12204a;display:grid;place-items:center;flex:none}
.plus:hover{border-color:var(--ne)}
.fld{flex:1;min-width:0;display:flex;align-items:center;background:#0a1330;border:1px solid var(--bd);border-radius:28px;padding:0 6px 0 16px}
textarea{flex:1;min-width:0;resize:none;border:0;outline:0;background:transparent;color:var(--tx);font:inherit;font-size:16px;padding:15px 4px;max-height:130px;line-height:1.5;direction:rtl;height:52px}
textarea::placeholder{color:var(--mut)}
#mic.rec{background:#e5484d;color:#fff;animation:pl 1s infinite}
@keyframes pl{50%{opacity:.6}}
#send{width:52px;height:52px;border-radius:50%;border:0;background:var(--bl);color:#fff;display:grid;place-items:center;flex:none;box-shadow:0 0 20px rgba(23,105,255,.55)}
#send:disabled{opacity:.5;box-shadow:none}
.pg{padding:20px 16px;overflow-y:auto;direction:rtl;max-width:760px;width:100%;margin:0 auto}
.pg h3{margin:4px 4px 16px;font-size:22px}
.cd{background:var(--card);border:1px solid var(--bd);border-radius:18px;padding:16px 18px;margin-bottom:12px;display:flex;align-items:center;gap:12px}
.cd .g{flex:1;min-width:0}
.cd b{display:block;font-size:15.5px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.cd small{color:var(--mut);font-size:12.5px}
.cd button.s{border:1px solid var(--bd);background:#12204a;border-radius:12px;padding:8px 14px;font-size:13.5px}
.cd button.s:hover{border-color:var(--ne)}
.cd button.d{border-color:#5a2230;color:#ff7b8f}
.sw{width:50px;height:28px;border-radius:14px;border:0;background:#26355c;position:relative;flex:none}
.sw:after{content:"";position:absolute;top:3px;right:3px;width:22px;height:22px;border-radius:50%;background:#fff;transition:.2s}
.sw.on{background:var(--bl)}.sw.on:after{right:25px}
.seg{display:flex;gap:6px}.seg button{border:1px solid var(--bd);background:#12204a;border-radius:10px;padding:7px 13px}.seg button.on{background:var(--bl);border-color:var(--bl)}
.big{display:grid;place-items:center;text-align:center;gap:14px;padding:40px 16px;flex:1}
.big .ring{width:140px;height:140px;filter:drop-shadow(0 0 16px rgba(45,140,255,.7))}
.pri{border:0;background:var(--bl);color:#fff;border-radius:16px;padding:14px 40px;font-size:16.5px;font-weight:600;box-shadow:0 0 20px rgba(23,105,255,.5)}
.toast{position:absolute;bottom:90px;left:50%;transform:translateX(-50%);background:#12204a;border:1px solid var(--ne);border-radius:14px;padding:10px 18px;font-size:13.5px;z-index:50;opacity:0;pointer-events:none;transition:.25s;white-space:nowrap}
.toast.show{opacity:1}
.foot{font-size:11.5px;color:var(--mut);text-align:center;padding:2px 8px 10px;direction:rtl}
#bk{display:none}
#gate{position:fixed;inset:0;z-index:200;background:radial-gradient(ellipse at 50% 20%,#0b1a3d,#050a18 70%);display:flex;align-items:center;justify-content:center;padding:20px;direction:rtl;overflow-y:auto}
#gate.hide{display:none}
.gc{width:100%;max-width:400px;text-align:center}
.gc .ring{width:130px;height:130px;margin:0 auto 6px;filter:drop-shadow(0 0 18px rgba(45,140,255,.7))}
.gc h2{margin:6px 0 4px;font-size:30px;color:var(--ne);text-shadow:0 0 18px rgba(45,140,255,.6)}
.gc p{color:var(--mut);margin:0 0 18px;line-height:1.8;font-size:14px}
.gc input{width:100%;background:#0a1330;border:1px solid var(--bd);border-radius:16px;padding:14px 16px;color:var(--tx);font:inherit;font-size:16px;margin-bottom:10px;outline:0}
.gc input:focus{border-color:var(--ne)}
.gc .pri{width:100%;margin-top:6px}
.er{color:#ff7b8f;font-size:13px;min-height:20px;margin:4px 0}
#un{font-size:13px;color:var(--ne);margin:-10px 0 14px}
@media (max-width:820px){
 #sb{position:fixed;top:0;bottom:0;left:0;transform:translateX(-105%);transition:transform .25s;padding-top:calc(22px + env(safe-area-inset-top,0px));box-shadow:10px 0 40px rgba(0,0,0,.6);overflow-y:auto}
 body.open #sb{transform:none}
 body.open #bk{display:block;position:fixed;inset:0;background:rgba(0,0,0,.6);z-index:20}
 .b{max-width:82%;padding:12px 15px 7px}
 :root{--fs:15.5px}
 .chips{padding:2px 8px}
 .plus,#send{width:46px;height:46px}
 textarea{height:46px;padding:12px 4px}
}
</style>
</head>
